{
"etk800_roof_wagon": {
    "information":{
        "authors":"BeamNG",
        "name":"Plain Roof",
        "value":400,
    },
    "slotType" : "etk800_roof_wagon",
    "slots2": [
        ["name",                   "allowTypes",               "denyTypes", "default",                "description"],
        ["etk800_headliner_wagon", ["etk800_headliner_wagon"], [],          "etk800_headliner_wagon", "Headliner",   {"coreSlot":true}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //body
         ["etk800_roof", ["etk800_body"]],
    ],
},
"etk800_roof_wagon_sun": {
    "information":{
        "authors":"BeamNG",
        "name":"Sunroof",
        "value":2500,
    },
    "slots2": [
        ["name",                           "allowTypes",                       "denyTypes", "default",                        "description"],
        ["etk800_glass_sunroof_wagon",     ["etk800_glass_sunroof_wagon"],     [],          "etk800_glass_sunroof_wagon",     "Sunroof Glass"],
        ["etk800_headliner_wagon_sunroof", ["etk800_headliner_wagon_sunroof"], [],          "etk800_headliner_wagon_sunroof", "Headliner",     {"coreSlot":true}],
    ],
    "slotType" : "etk800_roof_wagon",
    "nodes": [
         //redefine roof node
         ["id",   "posX", "posY", "posZ"],
         {"group":"etk800_body"},
         {"selfCollision":true},
         {"collision":true},
         {"nodeWeight":2.0},
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         ["rf2r",-0.56,   0.435,  1.36,   {"group":["etk800_body","etk800_roof"]}],
         ["rf2",  0,      0.40,   1.39,   {"nodeWeight":1.5,"group":["etk800_body","etk800_roof"]}],
         ["rf2l", 0.56,   0.435,  1.36,   {"group":["etk800_body","etk800_roof"]}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //body
         ["etk800_roof_sunroof", ["etk800_body"]],
    ],
},
"etk800_headliner_wagon": {
    "information":{
        "authors":"BeamNG",
        "name":"Headliner",
        "value":100,
