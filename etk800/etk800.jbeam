{
"etk800": {
    "information":{
        "authors":"BeamNG",
        "name": {
            "txt":"ui.vehicleconfig.information.name.BRAND BRAND",
            "ctx":{
                "brand1":"ui.vehicleconfig.brand.ETK",
                "brand2":"ui.vehicleconfig.brand.800-Series"
            }
        },
    },
    "slotType" : "main",
    "slots2": [
        ["name",                    "allowTypes",                "denyTypes", "default",           "description"],
        ["etk800_body",             ["etk800_body"],             [],          "etk800_body_wagon", "Body",                    {"coreSlot":true}],
        ["paint_design",            ["paint_design"],            [],          "",                  "Paint Design"],
        ["licenseplate_design_2_1", ["licenseplate_design_2_1"], [],          "",                  "License Plate Design"],
        ["etk800_mod",              ["etk800_mod"],              [],          "",                  "Additional Modification"],
    ],
    "components": {
        "electrics": {
            "customValues": [
                ["electricsName", "electricsFunction","electricsDefault"],
                ["lowhighbeam_filament","electrics.lowhighbeam * electrics.electricalLoadCoef",0],
                ["lowhighBrake_filament","(electrics.lowhighbeam * 0.25  + electrics.brakelights * 0.75 ) * electrics.electricalLoadCoef",0],
                ["foglight_filament","electrics.fog * electrics.electricalLoadCoef",0],
                ["highbeam_filament","electrics.highbeam * electrics.electricalLoadCoef",0],
                ["signal_L_filament","electrics.signal_L * electrics.electricalLoadCoef",0],
                ["signal_R_filament","electrics.signal_R * electrics.electricalLoadCoef",0],
                ["reverse_filament","electrics.reverse * electrics.electricalLoadCoef",0],
            ],
            "smoothers": [
                ["electricsName", "smootherType", "params"],
                ["lowhighbeam_filament","temporalNonLinear", [10,10]],
                ["lowhighBrake_filament","temporalNonLinear", [25,25]],
                ["foglight_filament","temporalNonLinear", [10,10]],
                ["highbeam_filament","temporalNonLinear", [10,10]],
                ["signal_L_filament","temporalNonLinear", [17,17]],
                ["signal_R_filament","temporalNonLinear", [17,17]],
                ["reverse_filament","temporalNonLinear", [10,10]],
            ],
        },
    },
    "glowMap":{
            //halogen
            "etk800_signal_L": {"simpleFunction":"signal_L_filament"    ,"off":"etk800_lights", "on":"etk800_lights_on_intense", "materialEmissiveScaling":{"on_max":1.00}},
            "etk800_signal_R": {"simpleFunction":"signal_R_filament"    ,"off":"etk800_lights", "on":"etk800_lights_on_intense", "materialEmissiveScaling":{"on_max":1.00}},
            "etk800_taillight":{"simpleFunction":"lowhighBrake_filament","off":"etk800_lights", "on":"etk800_lights_on_intense", "materialEmissiveScaling":{"on_max":1.00}},
            "etk800_foglight": {"simpleFunction":"foglight_filament"    ,"off":"etk800_lights", "on":"etk800_lights_on_intense", "materialEmissiveScaling":{"on_max":1.00}},

            //LED
            "etk800_chmsl":{"simpleFunction":{"brakelights":100}, "off":"etk800_lights", "on":"etk800_lights_on_intense", "on_intense":"etk800_lights_on_intense"},
            "etk800_headlight":{"simpleFunction":{"lowbeam":0.49,"highbeam":1}, "off":"etk800_lights", "on":"etk800_lights_on", "on_intense":"etk800_lights_on_intense"},
            "etk800_headlightglass":{"simpleFunction":{"lowbeam":0.49,"highbeam":1}, "off":"etk800_glass", "on":"etk800_glass_on", "on_intense":"etk800_glass_on_intense"},
            "etk800_runninglight":{"simpleFunction":{"running":1}, "off":"etk800_lights", "on":"etk800_lights_on_intense", "on_intense":"etk800_lights_on_intense"},
            "etk800_reverselight":{"simpleFunction":{"reverse":1}, "off":"etk800_lights", "on":"etk800_lights_on_intense", "on_intense":"etk800_lights_on_intense"},
            "etk800_lowhighbeam":{"simpleFunction":{"lowhighbeam":0.49}, "off":"etk800_lights", "on":"etk800_lights_on", "on_intense":"etk800_lights_on_intense"},
            "etk_gauges":{"simpleFunction":"lowhighbeam", "off":"etk_gauges", "on":"etk_gauges_on"},

            //gauge lights
            "signal_L":{"simpleFunction":"signal_L", "off":"invis", "on":"decals_gauges"},
            "signal_R":{"simpleFunction":"signal_R", "off":"invis", "on":"decals_gauges"},
            "checkengine":{"simpleFunction":"checkengine", "off":"invis", "on":"decals_gauges"},
            //"battery":{"simpleFunction":"battery", "off":"invis", "on":"decals_gauges"},
            "parkingbrake":{"simpleFunction":"parkingbrakelight", "off":"invis", "on":"decals_gauges"},
            "lowfuel":{"simpleFunction":"lowfuel", "off":"invis", "on":"decals_gauges"},
            "lowpressure":{"simpleFunction":"lowpressure", "off":"invis", "on":"decals_gauges"},
            "abs":{"simpleFunction":"abswarn", "off":"invis", "on":"decals_gauges"},
            "esc":{"simpleFunction":"esc", "off":"invis", "on":"decals_gauges"},
            "tcs":{"simpleFunction":"tcs", "off":"invis", "on":"decals_gauges"},
            "foglight":{"simpleFunction":"fog", "off":"invis", "on":"decals_gauges"},
            "rearfog":{"simpleFunction":"rearfog", "off":"invis", "on":"decals_gauges"},
            "oil":{"simpleFunction":"oil", "off":"invis", "on":"decals_gauges"},
            "lowbeam":{"simpleFunction":"lowhighbeam", "off":"invis", "on":"decals_gauges"},
            "highbeam":{"simpleFunction":"highbeam", "off":"invis", "on":"decals_gauges"},
    },
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$brakestrength", "range", "", "Brakes", 1, 0.6, 1.0, "Brake Force Multiplier", "Scales the overall brake torque for this setup", {"minDis":60, "maxDis":100}],
        ["$ffbstrength", "range", "", "Chassis", 1, 0.5, 1.5, "Setup-Specific Force Feedback Multiplier", "Scales the force feedback strength for THIS SETUP ONLY", {"minDis":50, "maxDis":150}],
        ["$headlightPitchComp", "range", "degree", "Headlights", 0, -3, 3, "Setup Specific Headlight Pitch Compensation", "Adjusts the headlight pitch  for this setup", {"minDis":-3, "maxDis":3}]
      ],
},
}
