{
"etk800_taillight_R": {
    "information":{
        "authors":"BeamNG",
        "name":"Right EUDM Taillight",
        "value":240,
    },
    "slotType" : "etk800_taillight_R",
    "slots2": [
        ["name", "allowTypes", "denyTypes", "default", "description"],
        ["etk800_taillight_R_running_bulb", ["generic_2inch_led_red_1W"], [], "generic_2inch_led_red_1W", "Running",
        {
        "coreSlot":true,
        "variables":{
          "$electric": "lowhighbeam",
          "$nodeRef":"tl4r", "$nodeX":"tl3r", "$nodeY":"tl2r",
          "$deformGroup":"taillightglass_R_break",
          "$shadowEnable":1,
          "$cookieName":"/art/special/BNG_light_cookie_taillight_incandescent.color.png",
          "$posX":-0.727, "$posY":2.080, "$posZ":0.814,
          "$rotX":0, "$rotY":0, "$rotZ":-45
        }
        }],
        ["etk800_taillight_R_brake_bulb", ["incandescent_red_21W"], [], "incandescent_red_21W", "Brake / Tail",
        {
        "coreSlot":true,
        "variables":{
          "$electric": "lowhighBrake_filament",
          "$nodeRef":"tl4r", "$nodeX":"tl3r", "$nodeY":"tl2r",
          "$deformGroup":"taillightglass_R_break",
          "$shadowEnable":1,
          "$cookieName":"/art/special/BNG_light_cookie_taillight_incandescent.color.png",
          "$posX":-0.676, "$posY":2.107, "$posZ":0.883,
          "$rotX":0, "$rotY":0, "$rotZ":0
        }
        }],
        ["etk800_taillight_R_signal_bulb", ["incandescent_amber_21W"], [], "incandescent_amber_21W", "Signal",
        {
        "coreSlot":true,
        "variables":{
          "$electric": "signal_R_filament",
          "$nodeRef":"tl3r", "$nodeX":"tl4r", "$nodeY":"tl1r",
          "$deformGroup":"taillightglass_R_break",
          "$shadowEnable":1,
          "$cookieName":"/art/special/BNG_light_cookie_taillight_incandescent.color.png",
          "$posX":-0.679, "$posY":2.142, "$posZ":0.788,
          "$rotX":0, "$rotY":0, "$rotZ":-5
        }
        }]
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["etk800_taillightframe_R", ["etk800_taillight_R"]],
         {"deformGroup":"taillightglass_R_break", "deformMaterialBase":"etk800_glass", "deformMaterialDamaged":"etk800_glass_dmg"},
         ["etk800_taillightglass_R", ["etk800_taillight_R"],[]{"deformSound":"event:>Destruction>Vehicle>Glass>extglassbreaksound1", "deformVolume":0.3}],
         {"deformGroup":""},
         {"deformGroup":"taillightglass_R_break", "deformMaterialBase":"etk800_lights", "deformMaterialDamaged":"etk800_lights_dmg"},
         ["etk800_taillight_euro_R", ["etk800_taillight_R"]],
         {"deformGroup":""},
    ],
    "nodes": [
         ["id",   "posX", "posY", "posZ"],
         //--taillight--
         //right
         {"selfCollision":true},
         {"collision":true},
         {"nodeMaterial":"|NM_PLASTIC"},
         {"frictionCoef":0.5},
         {"nodeWeight":0.4},
         {"group":"etk800_taillight_R"},
         ["tl1r",-0.625,  2.19,   0.93],
         ["tl2r",-0.735,  2.07,   0.93],
         ["tl3r",-0.635,  2.23,   0.79],
         ["tl4r",-0.76,   2.08,   0.79],
         ["tl5r",-0.825,  1.92,   0.81],
         {"selfCollision":false},
         {"nodeWeight":0.4},
         ["tl6r",-0.655,  2.06,   0.85],
         {"group":""},
    ],

    "beams": [
          ["id1:", "id2:"],
          //--taillight--
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":701000,"beamDamp":20},
          {"beamDeform":10000,"beamStrength":60000},
          //taillight main shape
          {"deformGroup":"taillightglass_R_break", "deformationTriggerRatio":0.05},
          //r
          {"deformLimitExpansion":1.1},
          ["tl1r", "tl2r"],
          ["tl3r", "tl4r"],
          ["tl1r", "tl3r"],
          ["tl2r", "tl4r"],

          ["tl1r", "tl4r"],
          ["tl2r", "tl3r"],

          ["tl2r", "tl5r"],
          ["tl4r", "tl5r"],

          ["tl6r", "tl1r"],
          ["tl6r", "tl2r"],
          ["tl6r", "tl5r"],
          ["tl6r", "tl4r"],
          ["tl6r", "tl3r"],

          //attach
          {"deformLimitExpansion":""},
          {"beamSpring":501000,"beamDamp":20},
          {"beamDeform":4000,"beamStrength":12000},
          {"breakGroup":"taillight_a_R"},
          ["tl1r", "q4r"],
          ["tl2r", "q4r"],
          ["tl3r", "q4r"],
          ["tl4r", "q4r"],
          ["tl3r", "r4rr"],
          ["tl4r", "r4rr"],
          ["tl3r", "r6rr"],
          ["tl4r", "r6rr"],
          ["tl5r", "q3r"],
          ["tl5r", "q9r"],
          ["tl6r", "q3r"],
          ["tl6r", "q9r"],
          ["tl1r", "r6"],
          ["tl3r", "r6"],
          {"breakGroup":""},
          {"deformGroup":"", "deformationTriggerRatio":""},

          //taillight support beams
          {"beamType":"|SUPPORT", "beamLongBound":1},
          {"beamSpring":401000,"beamDamp":20},
          {"beamDeform":5000,"beamStrength":330000},
          {"breakGroup":"taillight_R_supportBeams"},
          ["tl2r", "q9r"],
          ["tl4r", "q9r"],
          ["tl2r", "q3r"],
          ["tl1r", "q4r"],
          {"breakGroup":""},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"deformLimitExpansion":1.1},
    ],
    "triangles": [
            ["id1:", "id2:", "id3:"],
            //right taillight
            {"groundModel":"plastic"},
            {"group":"etk800_taillight_R"},
            {"dragCoef":8.75},
            ["tl1r", "tl3r", "tl4r"],
            ["tl2r", "tl4r", "tl5r"],
            {"triangleType":"NONCOLLIDABLE"},
            ["tl1r", "tl4r", "tl2r"],
            ["tl3r", "tl1r", "tl6r"],
            ["tl6r", "tl1r", "tl2r"],
            ["tl5r", "tl6r", "tl2r"],
            ["tl4r", "tl3r", "tl6r"],
            ["tl5r", "tl4r", "tl6r"],
            {"triangleType":"NORMALTYPE"},
            {"group":""},
    ],
},
