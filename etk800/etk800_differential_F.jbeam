        ["shaft", "wheelaxleFR", "differential_F", 2, {"deformGroups":["wheelaxleFR"], "breakTriggerBeam":"halfshaft_FR", "uiName":"Front Right Halfshaft", "friction":1.42, "dynamicFriction": 0.0034,"visualPositionRelativeChildren":[[0.3,0,0]]}],
