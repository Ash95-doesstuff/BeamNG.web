{
"etk800_headlight_R": {
    "information":{
        "authors":"BeamNG",
        "name":"Xenon Right Headlight",
        "value":700,
    },
    "slotType" : "etk800_headlight_R",
    "slots2": [
        ["name",                    "allowTypes",                "denyTypes", "default",                 "description"],
        ["etk800_headlightpanel_R", ["etk800_headlightpanel_R"], [],          "etk800_headlightpanel_R", "Right Headlight Access Panel"],
        ["etk800_headlight_R_low_bulb", ["headlightBulb_xenon_35W_projector"], [], "headlightBulb_xenon_35W_projector", "Low Beam",
        {
        "coreSlot":true,
        "variables":{
          "$electric": "lowhighbeam",
          "$lightPattern": "LHD"
          "$nodeRef":"he4r", "$nodeX":"he3r", "$nodeY":"he2r",
          "$deformGroup":"headlightglass_R_break",
          "$posX":-0.740, "$posY":-1.783, "$posZ":0.717,
          "$rotX":-0.57, "$rotY":0, "$rotZ":180
        }
        }],
        ["etk800_headlight_R_high_bulb", ["headlightBulb_halogen_60W"], [], "headlightBulb_halogen_60W", "High Beam",
        {
        "coreSlot":true,
        "variables":{
          "$electric": "highbeam_filament",
          "$lightPattern": "LHD"
          "$nodeRef":"he4r", "$nodeX":"he3r", "$nodeY":"he2r",
          "$deformGroup":"headlightglass_R_break",
          "$posX":-0.620, "$posY":-1.872, "$posZ":0.714,
          "$rotX":0, "$rotY":0, "$rotZ":180
        }
        }],
        ["etk800_headlight_R_signal_bulb", ["incandescent_amber_21W"], [], "incandescent_amber_21W", "Signal",
        {
        "coreSlot":true,
        "variables":{
          "$electric": "signal_R_filament",
          "$cookieName":"art/special/BNG_light_cookie_blinker_r_incandescent.color.png",
          "$nodeRef":"he4r", "$nodeX":"he3r", "$nodeY":"he2r",
          "$deformGroup":"headlightglass_R_break",
          "$posX":-0.496, "$posY":-2.054, "$posZ":0.722,
          "$rotX":0, "$rotY":0, "$rotZ":185
        }
        }]
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["etk800_headlightframe_R", ["etk800_headlight_R"]],
         {"deformGroup":"headlightglass_R_break", "deformMaterialBase":"etk800_glass", "deformMaterialDamaged":"etk800_glass_dmg"},
         ["etk800_headlightglass_R", ["etk800_headlight_R"],[]{"deformSound":"event:>Destruction>Vehicle>Glass>extglassbreaksound3", "deformVolume":0.4}],
         {"deformGroup":""},
         {"deformGroup":"headlightglass_R_break", "deformMaterialBase":"etk800_lights", "deformMaterialDamaged":"etk800_lights_dmg"},
         ["etk800_headlight_R", ["etk800_headlight_R"]],
         {"deformGroup":""},
    ],
    "nodes": [
         ["id",   "posX", "posY", "posZ"],
         //--HEADLIGHT--
         //right
         {"selfCollision":true},
         {"collision":true},
         {"nodeMaterial":"|NM_PLASTIC"},
         {"frictionCoef":0.5},
         {"nodeWeight":0.6},
         {"group":"etk800_headlight_R"},
         ["he1r",-0.50,  -2.10,   0.76],
         ["he3r",-0.49,  -2.11,   0.72],
         ["he2r",-0.78,  -1.84,   0.78],
         ["he4r",-0.78,  -1.88,   0.68],
         //{"selfCollision":false}
         ["he5r",-0.60,  -1.76,   0.72],
         {"group":""},
    ],

    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          //--HEADLIGHT--
          {"beamSpring":1001000,"beamDamp":60},
          {"beamDeform":12000,"beamStrength":62000},
          //headlight main shape
          {"deformGroup":"headlightglass_R_break", "deformationTriggerRatio":0.05},
          //r
          {"deformLimitExpansion":1.1},
          ["he1r", "he2r"],
          ["he3r", "he4r"],
          ["he1r", "he3r"],
          ["he2r", "he4r"],

          ["he1r", "he4r"],
          ["he2r", "he3r"],

          ["he1r", "he5r"],
          ["he2r", "he5r"],
          ["he3r", "he5r"],
          ["he4r", "he5r"],

          //attach
          {"beamSpring":301000,"beamDamp":60},
          {"beamDeform":3000,"beamStrength":24000},
          //r
          {"deformLimitExpansion":""},
          {"breakGroup":"headlight_R"},
          ["he5r", "f15rr"],
          ["he5r", "f15r"],
          ["he2r", "f15rr"],
          ["he2r", "f15r"],
          ["he4r", "f15rr"],

          {"beamDeform":3000,"beamStrength":24000},
          {"breakGroup":"headlight_R"},
          ["he1r", "f15r"],
          ["he1r", "f15rr"],
          ["he3r", "f15r"],
          ["he3r", "f13rr"],
          //["he1r","f13rr"],

          {"beamDeform":1500,"beamStrength":46000},
          ["he2r", "f18r"],
          ["he4r", "f18r"],
          ["he3r", "f11rr"],
          {"breakGroup":""},
          {"deformGroup":"", "deformationTriggerRatio":""},

          //headlight support beams
          {"beamType":"|SUPPORT", "beamLongBound":15},
          {"beamSpring":601000,"beamDamp":90},
          {"beamDeform":13000,"beamStrength":330000},
          {"optional":true},
          {"breakGroup":"headlight_R_supportBeams"},
          ["he2r", "h4"],
          ["he3r", "h4r"],
          ["he5r", "h4rr"],
          {"breakGroup":""},
          {"optional":false},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"deformLimitExpansion":1.1},
    ],
    "triangles": [
            ["id1:", "id2:", "id3:"],
            //right headlight
            {"groundModel":"plastic"},
            {"group":"etk800_headlight_R"},
            {"dragCoef":8.75},
            ["he3r", "he1r", "he4r"],
            ["he4r", "he1r", "he2r"],

            {"triangleType":"NONCOLLIDABLE"},
            ["he4r", "he2r", "he5r"],
            ["he1r", "he5r", "he2r"],
            ["he3r", "he5r", "he1r"],
            ["he4r", "he5r", "he3r"],
            {"triangleType":"NORMALTYPE"},
            {"group":""},
    ],
},
