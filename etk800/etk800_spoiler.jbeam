         ["lsp3ll", 0.565,  2.205,  0.97],
         {"group":""},
    ],
    "beams": [
          ["id1:",   "id2:"],
          //--SPOILER--
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":211000,"beamDamp":20},
          {"beamDeform":9000,"beamStrength":"FLT_MAX"},
          //spoiler main shape
          {"deformLimitExpansion":1.1},
          ["lsp1ll", "lsp2ll"],
          ["lsp2ll", "lsp3ll"],
          ["lsp3ll", "lsp1ll"],
