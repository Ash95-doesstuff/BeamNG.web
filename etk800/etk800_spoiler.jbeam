          ["lsp1",   "lsp1rr"],
          ["lsp3",   "lsp3rr"],
          //attach
          {"beamSpring":251000,"beamDamp":25},
          {"beamDeform":4500,"beamStrength":6000},
          {"breakGroup":"lipspoiler_L"},
