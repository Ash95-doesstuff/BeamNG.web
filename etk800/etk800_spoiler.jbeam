"etk800_spoiler_sedan_cf": {
    "information":{
        "authors":"BeamNG",
        "name":"Carbon Fiber Lip Spoiler",
        "value":50,
    },
    "slotType" : "etk800_spoiler_sedan",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["etk800_sedan_spoiler_lip_cf", ["etk800_trunk"]],
    ],
    "nodes": [
         ["id",    "posX", "posY", "posZ"],
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"collision":true},
         {"selfCollision":true},
         {"nodeWeight":0.2},
         {"group":"etk800_trunk_spoiler"},
         ["sp1rr",-0.605,  2.17,   1.01],
         ["sp1r", -0.32,   2.24,   1.04],
         ["sp1",   0.0,    2.255,  1.05],
         ["sp1l",  0.32,   2.24,   1.04],
         ["sp1ll", 0.605,  2.17,   1.01],
    ],
    "beams": [
          ["id1:",  "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

          //spoiler main shape
          {"beamSpring":401000,"beamDamp":20},
          {"beamDeform":15000,"beamStrength":"FLT_MAX"},
          {"deformLimitExpansion":1.1},
          ["sp1rr", "sp1r"],
          ["sp1r",  "sp1"],
          ["sp1",   "sp1l"],
          ["sp1l",  "sp1ll"],
          ["t3rr",  "sp1rr"],
          ["t3r",   "sp1r"],
          ["t3",    "sp1"],
          ["t3l",   "sp1l"],
          ["t3ll",  "sp1ll"],

          //crossing
          {"beamDeform":11000,"beamStrength":"FLT_MAX"},
          {"deformLimitExpansion":""},
          ["t3rr",  "sp1r"],
          ["sp1rr", "t3r"],
          ["sp1r",  "t3"],
          ["t3r",   "sp1"],
          ["t3",    "sp1l"],
          ["sp1",   "t3l"],
          ["t3l",   "sp1ll"],
          ["sp1l",  "t3ll"],

          //rigids
          {"beamDeform":6000,"beamStrength":"FLT_MAX"},
          ["sp1rr", "t4rr"],
          ["sp1r",  "t4r"],
          ["sp1",   "t4"],
          ["sp1l",  "t4l"],
          ["sp1ll", "t4ll"],
          ["sp1rr", "t1r"],
          ["sp1r",  "t1r"],
          ["sp1r",  "t1"],
          ["sp1",   "t1"],
          ["sp1l",  "t1"],
          ["sp1l",  "t1l"],
          ["sp1ll", "t1l"],

          ["sp1rr", "t5"],
          ["sp1r",  "t5"],
          ["sp1",   "t5"],
          ["sp1l",  "t5"],
          ["sp1ll", "t5"],

          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
    "triangles": [
            ["id1:",  "id2:",  "id3:"],
            {"groundModel":"metal"},
            {"dragCoef":26.25},
            {"group":"etk800_trunk_spoiler"},
            ["sp1rr", "t3rr",  "sp1r"],
            ["sp1r",  "t3rr",  "t3r"],
            ["sp1r",  "t3r",   "sp1"],
            ["sp1",   "t3r",   "t3"],
            ["sp1",   "t3",    "t3l"],
            ["t3l",   "sp1l",  "sp1"],
            ["sp1l",  "t3l",   "t3ll"],
            ["t3ll",  "sp1ll", "sp1l"],
    ],
