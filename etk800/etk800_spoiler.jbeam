          ["lsp3l",  "lsp1ll"],
          ["lsp1",   "lsp3l"],
          ["lsp3",   "lsp1l"],

          ["lsp2r",  "lsp3rr"],
          ["lsp3r",  "lsp2rr"],
          ["lsp2",   "lsp3r"],
          ["lsp3",   "lsp2r"],
          ["lsp2r",  "lsp1rr"],
          ["lsp1r",  "lsp2rr"],
          ["lsp2",   "lsp1r"],
          ["lsp1",   "lsp2r"],
          ["lsp1r",  "lsp3rr"],
          ["lsp3r",  "lsp1rr"],
          ["lsp1",   "lsp3r"],
          ["lsp3",   "lsp1r"],

