{
"scintilla_windshield": {
    "information":{
        "authors":"BeamNG",
        "name":"Windshield",
        "value":1200,
    },
    "slotType" : "scintilla_windshield",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],

         {"deformGroup":"windshield_break", "deformMaterialBase":"scintilla_glass", "deformMaterialDamaged":"scintilla_windshield_dmg"},
         ["scintilla_windshield", ["scintilla_windshield"],[]{"deformSound":"event:>Destruction>Vehicle>Glass>impact_glass_windscreen_01", "deformVolume":0.7}],
         {"deformGroup":"windshield_break", "deformMaterialBase":"scintilla_glass_int", "deformMaterialDamaged":"scintilla_glass_int"},
         //["scintilla_windshield_int", ["scintilla_windshield"]],
         {"deformGroup":"windshield_break", "deformMaterialBase":"glass_invisible", "deformMaterialDamaged":"glass_mirror"},
         ["scintilla_windshield_dmg", ["scintilla_windshield"]],
         {"deformGroup":""},
         ["scintilla_wiper", ["scintilla_windshield"]],
    ],
    "sounds": {
        "$+cabinFilterCoef": 0.12
    }
    "nodes": [
         ["id",    "posX", "posY", "posZ"],
         {"selfCollision":true},
         {"collision":true},
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_GLASS"},
         {"nodeWeight":2.0},
         {"group":["gps","scintilla_windshield"]},
         //windshield node
         ["wi1",   0.0,   -0.88,   0.98],
         {"group":""},

         //--ADD WEIGHT--
         {"group":"scintilla_body"},
         {"nodeMaterial":"|NM_METAL"},

         {"nodeWeight":3.5},
         {"group":["scintilla_body","scintilla_roof","gps","scintilla_windshield"]}
         ["rf1rr",-0.51,  -0.409,  1.096],
         ["rf1",   0.0,   -0.473,  1.143],
         ["rf1ll", 0.51,  -0.409,  1.096],

         //firewall
         {"nodeWeight":5.5},
         {"group":["scintilla_chassis","scintilla_dash","scintilla_windshield"]},
         ["f6rr", -0.695, -0.847,  0.8],
         ["f6r",  -0.285, -1.238,  0.78,    {"group":["scintilla_chassis","scintilla_dash","scintilla_windshield", "scintilla_frunk"]}],
         ["f6l",   0.285, -1.238,  0.78,    {"group":["scintilla_chassis","scintilla_dash","scintilla_windshield", "scintilla_frunk"]}],
         ["f6ll",  0.695, -0.847,  0.8],

         {"nodeWeight":3.3},
         //a pillar
         ["p1r",  -0.611, -0.648,  0.955,  {"group":["scintilla_body","gps","scintilla_windshield"]}]
         ["p1l",   0.611, -0.648,  0.955,  {"group":["scintilla_body","gps","scintilla_windshield"]}]
         {"group":""},

    ],

    "beams": [
          ["id1:", "id2:"],
          {"beamType":"|NORMAL", "beamPrecompression":1, "beamLongBound":1.0, "beamShortBound":1.0},
          //windshield
          {"disableMeshBreaking":true,"disableTriangleBreaking":true},
          {"beamSpring":1920800,"beamDamp":172},
          {"beamDeform":6000,"beamStrength":"FLT_MAX"},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"deformGroup":"windshield_break","deformationTriggerRatio":0.02},
          {"deformLimitExpansion":""},
          ["p1l",  "rf1rr"],
          ["p1r",  "rf1ll"],
          ["p1l",  "f6r"],
          ["p1r",  "f6l"],
          ["f6l",  "rf1"],
          ["rf1",  "f6r"],
          ["wi1",  "rf1"],
          ["wi1",  "f6r"],
          ["wi1",  "f6l"],
          ["wi1",  "p1l"],
          ["wi1",  "p1r"],
          ["wi1",  "p2rr"],
          ["wi1",  "p2ll"],
          ["wi1",  "f6ll"],
          ["wi1",  "f6rr"],
          ["wi1",  "p2r"],
          ["wi1",  "p2l"],
          ["wi1",  "rf1rr"],
          ["wi1",  "rf1ll"],
          ["wi1",  "fx4l"],
          ["wi1",  "fx4r"],
          {"breakGroup":""},
          {"disableMeshBreaking":false,"disableTriangleBreaking":false},
          {"deformGroup":"", "deformationTriggerRatio":""},
          {"deformLimitExpansion":1.2},
    ],
},
"scintilla_rearglass_hardtop":{
    "information":{
        "authors":"BeamNG",
        "name":"Hardtop Rear Glass",
        "value":300,
    },
    "slotType" : "scintilla_rearglass_hardtop",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        {"deformGroup":"rearglass_break", "deformMaterialBase":"scintilla_glass", "deformMaterialDamaged":"scintilla_glass_dmg"},
        ["scintilla_rear_glass_hardtop", ["scintilla_body","scintilla_chassis"],[]{"deformSound":"event:>Destruction>Vehicle>Glass>glassbreaksound10", "deformVolume":0.8}],
        {"deformGroup":"rearglass_break", "deformMaterialBase":"scintilla_glass_int", "deformMaterialDamaged":"scintilla_glass_dmg"},
        //["scintilla_rear_glass_hardtop_int", ["scintilla_body","scintilla_chassis"]],
        {"deformGroup":""},
    ],
    "sounds": {
        "$+cabinFilterCoef": 0.04
    }
    "nodes": [
         ["id",    "posX", "posY", "posZ"],
         {"selfCollision":true},
         {"collision":true},
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         //roof
         {"nodeWeight":2.5},
         {"group":["scintilla_body","scintilla_roof"]}
         ["rf4rr",-0.42,   0.526,  1.085],
         ["rf4",   0.0,    0.551,  1.12],
         ["rf4ll", 0.42,   0.526,  1.085],

         //rear firewall
         {"nodeWeight":3.5},
         {"group":"scintilla_chassis"}
         ["f10",   0.0,    0.526,  0.85],
         {"group":""}
    ],

    "beams": [
          ["id1:", "id2:"],
          {"beamType":"|NORMAL", "beamPrecompression":1, "beamLongBound":1.0, "beamShortBound":1.0},
          //rear window
          {"deformLimitExpansion":""},
          {"disableMeshBreaking":true,"disableTriangleBreaking":true},
          {"breakGroup":"backlight", "deformGroup":"rearglass_break","deformationTriggerRatio":0.05},
          {"beamSpring":832500,"beamDamp":45},
          {"beamDeform":13000,"beamStrength":15000},
          {"optional":true}
          ["f10",  "rf4"],
          ["f10l", "rf4rr"],
          ["f10r", "rf4ll"],
          {"optional":false}
          {"breakGroup":"", "deformGroup":"", "deformationTriggerRatio":""},
          {"disableMeshBreaking":false,"disableTriangleBreaking":false},
          {"deformLimitExpansion":1.2},
    ],
},
