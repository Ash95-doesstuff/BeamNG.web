{
"scintilla_sparetire_holder":
{
    "information":{
        "authors":"BeamNG",
        "name":"Spare Tire Holder",
        "value":400,
    },

    "slotType" :"scintilla_hood",
    "flexbodies":[
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["scintilla_front_tire_holder", ["scintilla_sparetire_holder"]],
    ],
    "slots2": [
        ["name",                 "allowTypes",             "denyTypes", "default",                        "description"],
        ["scintilla_sparewheel", ["scintilla_sparewheel"], [],          "scintilla_sparewheel_38b_18x10", "Spare Wheel"],

    ],
    "nodes":[
         ["id",     "posX", "posY", "posZ"],
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_PLASTIC"},
         {"selfCollision":true},
         {"collision":true},
         //spare tire holder
         {"nodeWeight":1.6},
         {"group":"scintilla_sparetire_holder"},
         ["spth1",  0.0,   -1.886,  0.665,  {"selfCollision":false}],
         ["spth2",  0.0,   -1.886,  0.45,   {"selfCollision":false}],
         {"nodeWeight":0.7},
         ["spth3l", 0.38,  -1.786,  0.43],
         ["spth3r",-0.38,  -1.786,  0.43],
         ["spth4l", 0.38,  -1.986,  0.43],
         ["spth4r",-0.38,  -1.986,  0.43],

         {"group":""},
        ],

    "beams":[
          ["id1:",   "id2:"],
          //--EXPANSION DEFORM LIMIT DEFAULT--
          {"deformLimitExpansion":1.2},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":801000,"beamDamp":125},
          {"beamDeform":6000,"beamStrength":"FLT_MAX"},
          //main shape
          ["spth1",  "spth2"],
          ["spth1",  "spth3r"],
          ["spth1",  "spth3l"],
          ["spth2",  "spth3r"],
          ["spth2",  "spth3l"],
          ["spth1",  "spth4r"],
          ["spth1",  "spth4l"],
          ["spth2",  "spth4r"],
          ["spth2",  "spth4l"],
          ["spth3l", "spth3r"],
          ["spth4l", "spth4r"],
          ["spth3l", "spth4l"],
          ["spth3r", "spth4r"],
          ["spth3l", "spth4r"],
          ["spth3r", "spth4l"],
          //attach
          {"beamSpring":501000,"beamDamp":75},
          {"beamDeform":4000,"beamStrength":73000},
          {"breakGroup":"sparetire_holder_L"},
          ["spth3l", "bbf2l"],
          ["spth3l", "bbf1l"],
          ["spth3l", "fx3l"],
          ["spth3l", "fx1l"],
          ["spth4l", "bbf2l"],
          ["spth4l", "bbf1l"],
          ["spth4l", "fx3l"],
          ["spth4l", "fx1l"],
          {"breakGroup":"sparetire_holder_R"},
          ["spth3r", "bbf2r"],
          ["spth3r", "bbf1r"],
          ["spth3r", "fx3r"],
          ["spth3r", "fx1r"],
          ["spth4r", "bbf2r"],
          ["spth4r", "bbf1r"],
          ["spth4r", "fx3r"],
          ["spth4r", "fx1r"],
          //weaker
          {"beamSpring":501000,"beamDamp":55},
          {"beamDeform":2000,"beamStrength":73000},
          {"breakGroup":"sparetire_holder_L"},
          ["spth1",  "bbf2l"],
          ["spth1",  "bbf1l"],
          ["spth1",  "fx3l"],
          ["spth1",  "fx1l"],

          ["spth2",  "bbf2l"],
          ["spth2",  "bbf1l"],
          ["spth2",  "fx3l"],
          ["spth2",  "fx1l"],
          {"breakGroup":"sparetire_holder_R"},
          ["spth1",  "bbf2r"],
          ["spth1",  "bbf1r"],
          ["spth1",  "fx3r"],
          ["spth1",  "fx1r"],

          ["spth2",  "bbf2r"],
          ["spth2",  "bbf1r"],
          ["spth2",  "fx3r"],
          ["spth2",  "fx1r"],
          {"breakGroup":""},
          //bleed through
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"deformLimitExpansion":1.2},
    ],

    "triangles":[
        ["id1:", "id2:", "id3:"],
        {"triangleType":"NORMALTYPE"},
        {"groundModel":"metal"},

        //frunk
        {"dragCoef":10.32},
        {"group":"scintilla_sparetire_holder"},

        {"group":""},
        ],
},
