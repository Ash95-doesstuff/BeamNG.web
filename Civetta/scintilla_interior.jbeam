    ],
    "triggers2":[
        ["id", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        ["axle_lift", "dsh1","dsh1r","dsh2", "sphere", 0.015, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":-0.031, "y":0.395, "z":-0.030}],
        ["hazard", "dsh1","dsh1r","dsh2", "sphere", 0.015, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.000, "y":0.405, "z":-0.015}],
        ["handbrake", "dsh1","dsh1r","dsh2", "box", {"x":0.025, "y":0.03, "z":0.02}, {"x":38, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.03, "y":0.43, "z":-0.01}],
        ["launch", "dsh1","dsh1r","dsh2", "box", {"x":0.02, "y":0.02, "z":0.01}, {"x":38, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":-0.007, "y":0.349, "z":-0.095}],
    ],
    "actionsEnabled": [
        ["id"],
        ["axle_lift"],
    ],
    "triggerEventLinks2": [
        ["triggerId:triggers2", "triggerInput", "inputAction"],
        ["axle_lift", "action0", "axle_lift"],
        ["hazard", "action0", "common:toggle_hazard_signal"],
        ["handbrake", "action0", "common:parkingbrake_toggle"],
        ["launch", "action0", "common:toggleTwoStep"],
