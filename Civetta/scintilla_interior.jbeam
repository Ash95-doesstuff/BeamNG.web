"scintilla_shifter_race_dct": {
    "information":{
        "authors":"BeamNG",
        "name":"DCT Shifter",
        "value":250,
    },
    "slotType" : "scintilla_shifter_race",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["grp_shifter_m_housing", ["shifter_body","scintilla_floor"], [], {"pos":{"x":0.015, "y":-0.37, "z":0.52}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.2, "y":1.2, "z":1.2}}],
         ["grp_shifter_m_details", ["shifter_body","scintilla_floor"], [], {"pos":{"x":0.015, "y":-0.37, "z":0.52}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.2, "y":1.2, "z":1.2}}],
         ["grp_shifter_m_sphere",  ["shifter_lever"], [],                  {"pos":{"x":0.015, "y":-0.37, "z":0.52}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.2, "y":1.2, "z":1.2}}],
         ["grp_shifter_m_stick",   ["shifter_lever"], [],                  {"pos":{"x":0.015, "y":-0.37, "z":0.52}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.2, "y":1.2, "z":1.2}}],
         ["grp_shifter_knob_a",    ["shifter_lever"], [],                  {"pos":{"x":0.015, "y":-0.37, "z":0.52}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.2, "y":1.2, "z":1.2}}],
    ],
    "controller": [
        ["fileName"],
        ["propAnimation/dualAxisLever", {"name":"dualAxisLever"}],
    ]
    "dualAxisLever": {
        //PRNDS column at X -0.5, M gate at X +0.5
        "orderedModeCoordinates": [
            ["modeName",   "x",      "y"]
            ["P",           0.0,     0.9]
            ["R",           0.0,     0.45]
            ["N",           0.0,     0.0]
            ["D",           0.0,    -0.45]
            ["S",           0.0,    -0.7]
            ["M",           0.5,    -0.7]
        ]
        //M gear changes are forward/back impulses in the M gate
        "impulseModeCoordinates": [
            ["modeName",   "x",      "y"]
            ["M+",          0.5,    -0.9]
            ["M-",          0.5,    -0.5]
        ]
        "modeChanges": [
            ["mode1",   "mode2",    "intermediateCoordinates"],
            ["S",       "M",        [{"x":0.5,"y":-0.9}]],
        ]
        "moveSoundNode:":["sh_b5"]
        "moveSoundEvent":  "event:>Vehicle>Interior>Gearshift>manual_modern_09_in",
        "moveSoundVolume": 0.5,
        "electricsNameMode":"gear"
    },
    "nodes": [
         ["id",     "posX", "posY", "posZ"],
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"collision":true},
         {"selfCollision":false},
         //--SHIFTER--- jbeamed cage, same relative layout as generic GRP manual shifter (Covet), at scintilla flexbody pos
         {"group":"shifter_body"},
         {"nodeWeight":0.45}
         ["sh_b1",  0.065, -0.435,  0.510],
         ["sh_b2", -0.035, -0.435,  0.510],
         ["sh_b3",  0.065, -0.304,  0.510],
         ["sh_b4", -0.035, -0.304,  0.510],
         ["sh_b5",  0.015, -0.370,  0.50],
         {"selfCollision":true},
         {"group":"shifter_lever"},
         {"nodeWeight":0.5}
         ["sh_l1",  0.015, -0.370,  0.700],
         {"selfCollision":false},
         {"nodeWeight":0.30}
         ["sh_l2", -0.005, -0.400,  0.610],
         ["sh_l3",  0.035, -0.400,  0.610],
         ["sh_l4", -0.005, -0.340,  0.610],
         ["sh_l5",  0.035, -0.340,  0.610],
         {"group":""},
    ],
    "beams":[
        ["id1:",   "id2:"],
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        //main shape
        {"beamSpring":401000,"beamDamp":55},
        {"beamDeform":259000,"beamStrength":"FLT_MAX"},
        {"deformLimitExpansion":1.1},
        ["sh_b1",  "sh_b2"],
        ["sh_b1",  "sh_b3"],
        ["sh_b1",  "sh_b4"],
        ["sh_b2",  "sh_b3"],
        ["sh_b2",  "sh_b4"],
        ["sh_b3",  "sh_b4"],

        ["sh_b1",  "sh_b5"],
        ["sh_b2",  "sh_b5"],
        ["sh_b3",  "sh_b5"],
        ["sh_b4",  "sh_b5"],
        //lever
        {"beamSpring":121000,"beamDamp":35},
        ["sh_l1",  "sh_l2"],
        ["sh_l1",  "sh_l3"],
        ["sh_l1",  "sh_l4"],
        ["sh_l1",  "sh_l5"],

        ["sh_l2",  "sh_l3"],
        ["sh_l2",  "sh_l4"],
        ["sh_l2",  "sh_l5"],

        ["sh_l3",  "sh_l4"],
        ["sh_l3",  "sh_l5"],
        ["sh_l4",  "sh_l5"],
        //hinge
        {"beamSpring":121000,"beamDamp":25},
        ["sh_b5",  "sh_l1"],
        ["sh_b5",  "sh_l2"],
        ["sh_b5",  "sh_l3"],
        ["sh_b5",  "sh_l4"],
        ["sh_b5",  "sh_l5"],

        //stabilize the lever
        {"beamSpring":0,"beamDamp":175},
        ["sh_b1",  "sh_l1"],
        ["sh_b2",  "sh_l1"],
        ["sh_b3",  "sh_l1"],
        ["sh_b4",  "sh_l1"],
        {"breakGroup":""},

        //attach to floor (Covet-spec: stiff to close f7/f2, softer to forward f8)
        {"beamSpring":300000,"beamDamp":70},
        {"beamDeform":1000,"beamStrength":"FLT_MAX"},
        ["sh_b1", "f7r"],
        ["sh_b2", "f7r"],
        ["sh_b3", "f7r"],
        ["sh_b4", "f7r"],
        ["sh_b5", "f7r"],
        ["sh_b1", "f7l"],
