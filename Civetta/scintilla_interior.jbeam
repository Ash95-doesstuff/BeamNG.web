        ["sh_b1", "f2l"],
        ["sh_b2", "f2l"],
        ["sh_b3", "f2l"],
        ["sh_b4", "f2l"],
        ["sh_b5", "f2l"],
        {"beamSpring":200000,"beamDamp":20},
        ["sh_b1", "f8r"],
        ["sh_b2", "f8r"],
        ["sh_b3", "f8r"],
        ["sh_b4", "f8r"],
        ["sh_b5", "f8r"],
        ["sh_b1", "f8l"],
        ["sh_b2", "f8l"],
        ["sh_b3", "f8l"],
        ["sh_b4", "f8l"],
        ["sh_b5", "f8l"],
        //support beams
        {"beamType":"|SUPPORT","beamPrecompression":0.88,"beamLongBound":2},
        {"beamSpring":201000,"beamDamp":50},
        {"beamDeform":16000,"beamStrength":"FLT_MAX"},
        ["sh_l3", "sh_b3"],
        ["sh_l5", "sh_b1"],
        ["sh_l4", "sh_b2"],
        ["sh_l2", "sh_b4"],
        {"beamPrecompression":0.905}
        ["sh_l1", "sh_b1"],
        ["sh_l1", "sh_b2"],
        ["sh_l1", "sh_b3"],
        ["sh_l1", "sh_b4"],
        {"beamPrecompression":1,"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        {"deformLimitExpansion":""},
    ],
    "torsionHydros": [
        ["id1:","id2:","id3:","id4:"],
        {"spring":200, "damp":1, "deform":"FLT_MAX", "strength":1000},
        ["sh_b3","sh_b1","sh_b2","sh_l1",  {"inputSource":"dualAxisY","factor":-0.25}],
