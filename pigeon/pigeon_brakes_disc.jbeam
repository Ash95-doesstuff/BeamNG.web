{
"pigeon_brake_F_3w_disc": {
    "information":{
        "authors":"BeamNG",
        "name":"Race Front Disc Brake",
        "value":125,
    },
    "slotType" : "pigeon_brake_F_3w",
    "slots2": [
        ["name",       "allowTypes",   "denyTypes", "default",    "description"],
        ["brakepad_F", ["brakepad_F"], [],          "brakepad_F", "Front Brake Pads", {"coreSlot":true}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["brake_hub_3l",               ["wheel_F","wheelhub_F"],         [], {"pos":{"x": -0.02, "y":-1.096, "z":0.2407}, "scale":{"x":0.7, "y":1.0,  "z":1.0}, "rot":{"x":180, "y":180,  "z":0  }}],
        ["brake_disc_plain",           ["wheel_F","wheelhub_F"],         [], {"pos":{"x": -0.01, "y":-1.096, "z":0.2407}, "scale":{"x":0.7, "y":0.7, "z":0.7},  "rot":{"x":180, "y":0,  "z":0  }, "materialOverride":[["disc_brake", "disc_brake_F"]]}],
        ["brake_caliper_standard_red", ["pigeon_spindle_F","wigeon_spindle_F","wheelhub_F"], [], {"pos":{"x": -0.01, "y":-1.096, "z":0.2407}, "scale":{"x":0.7, "y":0.6, "z":0.6},  "rot":{"x":180,  "y":180,"z":0  }}],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$brakebias", "range", "", "Brakes", 0.77, 0, 1, "Front/Rear Bias", "Percent of brake torque to the front wheels", {"minDis":0, "maxDis":100}],
    ],
    "pressureWheels": [
        ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
        //brakes
        {"brakeTorque":"$=$brakestrength*650*$brakebias"},
        {"brakeInputSplit":1},
        {"brakeSplitCoef":1},
        {"parkingTorque":0},
        {"brakeSpring":95},

        //brake thermals
        {"enableBrakeThermals":true},
        {"brakeDiameter":0.16},
        {"brakeMass":2.75},
        {"brakeType":"vented-disc"},
        {"rotorMaterial":"steel"},
        {"brakeVentingCoef":1.4},
        //brake sounds
        {"squealCoefNatural": 1.0, "squealCoefLowSpeed": 1.0}
    ],
},
