"pigeon_brake_R_disc": {
    "information":{
        "authors":"BeamNG",
        "name":"Race Rear Disc Brakes",
        "value":250,
    },
    "slotType" : "pigeon_brake_R",
    "slots2": [
        ["name",       "allowTypes",   "denyTypes", "default",    "description"],
        ["brakepad_R", ["brakepad_R"], [],          "brakepad_R", "Rear Brake Pads", {"coreSlot":true}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["brake_hub_3l",               ["wheel_RR","wheelhub_RR"],     [], {"pos":{"x":-0.52, "y":1.013, "z":0.2407}, "scale":{"x":0.8, "y":1.0,  "z":1.0}, "rot":{"x":0,   "y":0,  "z":0  }}],
        ["brake_hub_3l",               ["wheel_RL","wheelhub_RL"],     [], {"pos":{"x": 0.52, "y":1.013, "z":0.2407}, "scale":{"x":0.8, "y":1.0,  "z":1.0}, "rot":{"x":180, "y":180,"z":0  }}],
        ["brake_disc_plain",           ["wheel_RR","wheelhub_RR"],     [], {"pos":{"x":-0.53, "y":1.013, "z":0.2407}, "scale":{"x":0.7, "y":0.65, "z":0.65},  "rot":{"x":0,   "y":0,  "z":0  }, "materialOverride":[["disc_brake", "disc_brake_RR"]]}],
        ["brake_disc_plain",           ["wheel_RL","wheelhub_RL"],     [], {"pos":{"x": 0.53, "y":1.013, "z":0.2407}, "scale":{"x":0.7, "y":0.65, "z":0.65},  "rot":{"x":180, "y":0,  "z":0  }, "materialOverride":[["disc_brake", "disc_brake_RL"]]}],
        ["brake_caliper_standard_red", ["pigeon_axle","wigeon_axle","wheelhub_RR"], [], {"pos":{"x":-0.53, "y":1.013, "z":0.2407}, "scale":{"x":0.7, "y":0.55, "z":0.55},  "rot":{"x":180, "y":0,  "z":0  }}],
        ["brake_caliper_standard_red", ["pigeon_axle","wigeon_axle","wheelhub_RL"], [], {"pos":{"x": 0.53, "y":1.013, "z":0.2407}, "scale":{"x":0.7, "y":0.55, "z":0.55},  "rot":{"x":180,  "y":180,"z":0  }}],
    ],
    "pressureWheels": [
        ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
        //brakes
        //{"brakeTorque":"$=case($brakebias == nil, $brakestrength*600, $brakestrength*1500*(1-$brakebias))"},
        {"brakeTorque":"$=$brakebias == nil and $brakestrength*600 or $brakestrength*1300*(1-$brakebias)"},
        {"brakeInputSplit":1},
        {"brakeSplitCoef":1},
        {"parkingTorque":1200},
        {"brakeSpring":95},

        //brake thermals
        {"enableBrakeThermals":true},
        {"brakeDiameter":0.14},
        {"brakeMass":2.0},
        {"brakeType":"vented-disc"},
        {"rotorMaterial":"steel"},
        {"brakeVentingCoef":1.0},
        //brake sounds
        {"squealCoefNatural": 0.0, "squealCoefLowSpeed": 0.0}
    ],
},
