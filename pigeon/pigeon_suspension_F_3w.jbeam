        {"selfCollision":false},
        {"collision":true},
        {"hubcapBreakGroup":"hubcap_F"},
        {"hubcapGroup":"hubcap_F"},
        {"axleBeams":["axle_F"]},
        ["F", "wheel_F", "tire_F", "fw1l", "fw1r", 9999, "fh3", -1, {"steerAxisUp:":"fh2","steerAxisDown:":"fh1"}],
