"pigeon_steering_3w": {
    "information":{
        "authors":"BeamNG",
        "name":"Steering",
        "value":80,
    },
    "slotType" : "pigeon_steering_3w",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["pigeon_steering_3w", ["pigeon_body"]],
         ["pigeon_steerbox_3w", ["pigeon_frame", "pigeon_steeringbox"]],
         ["pigeon_pushrod_F_3w", ["pigeon_pitman", "pigeon_steeringbox"]],
         ["pigeon_steeringrod_3w", ["pigeon_pitman", "pigeon_steering_rod"]],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$steer_center", "range", "", "Wheel Alignment", 0.9969, 1.02, 0.98, "Steering Center", "Percentage of adjustment range", {"subCategory":" Front"}],
    ],
    "nodes": [
         ["id",   "posX", "posY", "posZ"],
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"collision":true},
         {"selfCollision":false},
         {"nodeWeight":2.0},
         {"group":"pigeon_pitman"},
         ["st1r",-0.365, -0.955,  0.24],
         {"group":"pigeon_steeringbox"},
         {"nodeWeight":2.0},
         ["st2r",-0.38,  -0.921,  0.522],
         ["st3r",-0.22,  -0.921,  0.522],
         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamSpring":3001000,"beamDamp":150},
          {"beamDeform":10000,"beamStrength":500000},
          //pitman arm
          {"deformLimitExpansion":1.2},
          ["st2r", "st1r"],
          ["st3r", "st1r"],

          //tierod
          {"beamSpring":5001000,"beamDamp":150},
          ["st1r", "fh5",  {"beamPrecompression":"$=$steer_center+0.003","beamPrecompressionTime":0.5}],

          //steering box
          {"deformLimitExpansion":""},
          {"beamSpring":2001000,"beamDamp":150},
          {"beamDeform":6000,"beamStrength":1500000},
          ["st3r", "f1r"],
          ["st3r", "f7r"],
          ["st3r", "f2r"],
          ["st3r", "f8r"],
          ["st3r", "f7"],
          ["st3r", "f1"],

          ["st2r", "f1r"],
          ["st2r", "f7r"],
          ["st2r", "f2r"],
          ["st2r", "f8r"],
          ["st2r", "f7"],
          ["st2r", "f1"],

          ["st2r", "st3r"],

          //steering damper
          {"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":0,"beamDeform":50000,"beamStrength":1000000},
          {"beamLimitSpring":0,"beamLimitDamp":0},
          {"beamDamp":100},
          ["fh5",  "fx3",  {"beamDampVelocitySplit":0.05,"beamDampFast":250,"dampCutoffHz":1000}],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"deformLimitExpansion":1.2},
    ],
    "triangles": [
            ["id1:", "id2:", "id3:"],
            //pitman arm
            {"triangleType":"NONCOLLIDABLE"},
            ["st2r", "st1r", "st3r"],
            {"triangleType":"NORMALTYPE"},
    ],
    "torsionHydros": [
        ["id1:","id2:","id3:","id4:"],
        {"spring":150000, "damp":20, "deform":"FLT_MAX", "strength":"FLT_MAX"},
        ["st1r","st2r","st3r","f2r", {"outLimit":-0.40,"inLimit":0.40,"steeringWheelLock":540,"inRate":5,"outRate":5,"inputSource":"steering_input"}],
    ],
    "input": {
        "FFBcoef":"$=$ffbstrength*9",
    },
},
}