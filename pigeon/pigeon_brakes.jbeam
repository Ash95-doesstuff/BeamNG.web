{
"pigeon_brake_F_3w": {
    "information":{
        "authors":"BeamNG",
        "name":"Front Drum Brake",
        "value":80,
    },
    "slotType" : "pigeon_brake_F_3w",
    "slots2": [
        ["name",       "allowTypes",   "denyTypes", "default",    "description"],
        ["brakepad_F", ["brakepad_F"], [],          "brakepad_F", "Front Brake Pads", {"coreSlot":true}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["pigeon_brakedrum_F_3w", ["wheel_F","wheelhub_F"]],
    ],
    "pressureWheels": [
        ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
        {"brakeTorque":"$=$brakestrength*650"},
        {"parkingTorque":0},
        {"brakeSpring":100},

        //brake thermals
        {"enableBrakeThermals":true},
        {"brakeDiameter":0.17},
        {"brakeMass":2.0},
        {"brakeType":"drum"},
        {"rotorMaterial":"steel"},
        {"brakeVentingCoef":0.8},
        //brake sounds
        {"squealCoefNatural": 0.0, "squealCoefLowSpeed": 0.0}
    ],
},
