"pigeon_coilover_R_race": {
    "information":{
        "authors":"BeamNG",
        "name":"Race Rear Coilovers",
        "value":1400,
    },
    "slotType" : "pigeon_coilover_R",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["pigeon_coilover_R_race", ["pigeon_shock_R"]],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$springheight_R", "range", "+m", "Suspension", 0, -0.06, 0.04, "Spring Height", "Raise or lower the suspension height", {"stepDis":0.001, "subCategory":"Rear"}],
        ["$spring_R", "range", "N/m", "Suspension", 40000, 20000, 80000, "Spring Rate", "Spring stiffness", {"stepDis":500, "subCategory":"Rear"}],
        ["$damp_bump_R", "range", "N/m/s", "Suspension", 1500, 200, 5000, "Bump Damping", "Damper rate in compression", {"stepDis":100, "subCategory":"Rear"}],
        ["$damp_rebound_R", "range", "N/m/s", "Suspension", 5000, 500, 10000, "Rebound Damping", "Damper rate in extension", {"stepDis":100, "subCategory":"Rear"}],
    ],
    "beams": [
          ["id1:",    "id2:"],
          //rear springs
          {"beamType":"|NORMAL"},
          {"beamDeform":15000,"beamStrength":150000},
          {"beamSpring":"$spring_R","beamDamp":0},
          ["rshkb1r", "rshkt1r", {"precompressionRange":"$=$springheight_R+0.015", "soundFile":"event:>Vehicle>Suspension>car_vint_sml_01>spring_compress_01","colorFactor":0.6,"attackFactor":8,"volumeFactor":15,"decayFactor":5,"noiseFactor":0.01,"pitchFactor":0.7,"maxStress":15000}],
          ["rshkb1l", "rshkt1l", {"precompressionRange":"$=$springheight_R+0.015", "soundFile":"event:>Vehicle>Suspension>car_vint_sml_01>spring_compress_01","colorFactor":0.6,"attackFactor":8,"volumeFactor":15,"decayFactor":5,"noiseFactor":0.01,"pitchFactor":0.7,"maxStress":15000}],
          //rear dampers
          {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":0,"beamDamp":"$damp_bump_R"},
          {"beamLimitSpring":0,"beamLimitDamp":0},
          ["rshkb1r", "rshkt1r", {"beamDampRebound":"$damp_rebound_R","beamDampVelocitySplit":0.4,"beamDampFast":"$=$damp_bump_R / 3","beamDampReboundFast":"$=$damp_rebound_R / 3","dampCutoffHz":400}],
          ["rshkb1l", "rshkt1l", {"beamDampRebound":"$damp_rebound_R","beamDampVelocitySplit":0.4,"beamDampFast":"$=$damp_bump_R / 3","beamDampReboundFast":"$=$damp_rebound_R / 3","dampCutoffHz":400}],
          //bumpstops
          {"beamSpring":0,"beamDamp":0},
          {"beamLimitSpring":101000,"beamLimitDamp":3000},
          ["rshkb1r", "rshkt1r", {"longBoundRange":0.08,"shortBoundRange":0.07,"boundZone":0.03,"beamLimitDampRebound":0,"dampCutoffHz":250}],
          ["rshkb1l", "rshkt1l", {"longBoundRange":0.08,"shortBoundRange":0.07,"boundZone":0.03,"beamLimitDampRebound":0,"dampCutoffHz":250}],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
},
