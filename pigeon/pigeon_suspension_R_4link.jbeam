        ["$damp_bump_R", "range", "N/m/s", "Suspension", 1000, 250, 5000, "Bump Damping", "Damper rate in compression", {"stepDis":100, "subCategory":"Rear"}]
        ["$damp_bump_R_fast", "range", "N/m/s", "Suspension", 1600, 500, 5000, "Fast Bump Damping", "Damper rate in fast compression", {"stepDis":100, "subCategory":"Rear"}]
        ["$damp_rebound_R", "range", "N/m/s", "Suspension", 3000, 500, 10000, "Rebound Damping", "Damper rate in extension", {"stepDis":100, "subCategory":"Rear"}]
    ],
    "beams": [
          ["id1:",    "id2:"],
          //rear springs
          {"beamType":"|NORMAL"},
          {"beamDeform":15000,"beamStrength":150000},
          {"beamSpring":"$spring_R","beamDamp":0},
          ["rshkb1r", "rshkt1r", {"precompressionRange":"$=$springheight_R+0.135", "soundFile":"event:>Vehicle>Suspension>car_vint_sml_01>spring_compress_01","colorFactor":0.6,"attackFactor":5,"volumeFactor":12,"decayFactor":4,"noiseFactor":0.01,"pitchFactor":0.8,"maxStress":14000}],
          ["rshkb1l", "rshkt1l", {"precompressionRange":"$=$springheight_R+0.135", "soundFile":"event:>Vehicle>Suspension>car_vint_sml_01>spring_compress_01","colorFactor":0.6,"attackFactor":5,"volumeFactor":12,"decayFactor":4,"noiseFactor":0.01,"pitchFactor":0.8,"maxStress":14000}],
          //rear dampers
          {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":0,"beamDamp":"$damp_bump_R"},
          {"beamLimitSpring":0,"beamLimitDamp":0},
          ["rshkb1r", "rshkt1r", {"beamDampRebound":"$damp_rebound_R","beamDampVelocitySplit":1.8,"beamDampFast":"$damp_bump_R_fast","beamDampReboundFast":"$damp_rebound_R","dampCutoffHz":400}],
          ["rshkb1l", "rshkt1l", {"beamDampRebound":"$damp_rebound_R","beamDampVelocitySplit":1.8,"beamDampFast":"$damp_bump_R_fast","beamDampReboundFast":"$damp_rebound_R","dampCutoffHz":400}],
          //bumpstops
          {"beamSpring":0,"beamDamp":0},
          {"beamLimitSpring":101000,"beamLimitDamp":3000},
          ["rshkb1r", "rshkt1r", {"longBoundRange":0.11,"shortBoundRange":0.05,"boundZone":0.04,"beamLimitDampRebound":0,"dampCutoffHz":250}],
          ["rshkb1l", "rshkt1l", {"longBoundRange":0.11,"shortBoundRange":0.05,"boundZone":0.04,"beamLimitDampRebound":0,"dampCutoffHz":250}],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
},
