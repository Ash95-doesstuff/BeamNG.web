{
"pigeon_headlight_R": {
    "information":{
        "authors":"BeamNG",
        "name":"Right Headlight",
        "value":40,
    },
    "slotType" : "pigeon_headlight_R",
    "slots2": [
        ["name",                            "allowTypes",                 "denyTypes", "default",                "description"],
        ["pigeon_headlight_R_low_bulb",     ["headlightBulb_halogen_55W_combined"],  [],          "headlightBulb_halogen_55W_combined", "Right Low Beam Bulb",
        {
        "coreSlot":true,
        "variables":{
          "$electric":"lowbeam_filament",
          "$lightPattern":"RHD",
          "$nodeRef":"fe2r", "$nodeX":"fe2rr", "$nodeY":"fe1r",
          "$deformGroup":"headlight_R_break",
          "$posX":-0.375, "$posY":-1.384, "$posZ":0.691,
          "$rotX":-0.57, "$rotY":0, "$rotZ":180,
          //"$lightBrightness":0.3,
          //"$lightOuterAngle":75,
          //"$flareScale":0.06
        }
        }],
        ["pigeon_headlight_R_high_bulb",    ["headlightBulb_halogen_60W_combined"],  [],          "headlightBulb_halogen_60W_combined", "Right High Beam Bulb",
        {
        "coreSlot":true,
        "variables":{
          "$electric":"highbeam_filament",
          "$lightPattern":"RHD",
          "$nodeRef":"fe2r", "$nodeX":"fe2rr", "$nodeY":"fe1r",
          "$deformGroup":"headlight_R_break",
          "$posX":-0.375, "$posY":-1.384, "$posZ":0.691,
          "$rotX":0, "$rotY":0, "$rotZ":180,
          //"$lightBrightness":0.6,
          //"$lightOuterAngle":85,
          //"$flareScale":0.08
        }
        }]
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],

         {"deformGroup":"headlight_R_break", "deformMaterialBase":"pigeon_glass", "deformMaterialDamaged":"pigeon_glass_dmg"},
         ["pigeon_headlightglass_R", ["pigeon_body"]],
         {"deformGroup":"headlight_R_break", "deformMaterialBase":"pigeon_lights", "deformMaterialDamaged":"pigeon_lights_dmg"},
         ["pigeon_headlight_R", ["pigeon_body"]],
         {"deformGroup":""},
    ],
},
