{
"pigeon_transmission_3M": {
    "information":{
        "authors":"BeamNG",
        "name":"3-Speed Manual Transmission",
        "value":150,
    },
    "slotType" : "pigeon_transmission",
    "slots2": [
        ["name",            "allowTypes",        "denyTypes", "default",         "description"],
        ["pigeon_flywheel", ["pigeon_flywheel"], [],          "pigeon_flywheel", "Flywheel",    {"coreSlot":true}],
    ],
    "powertrain": [
        ["type", "name", "inputName", "inputIndex"],
        ["frictionClutch", "clutch", "mainEngine", 1],
        ["manualGearbox", "gearbox", "clutch", 1],
    ],
    "gearbox": {
        "uiName":"Gearbox",
        "gearRatios":[-3.25, 0, 3.876, 1.79, 1.0],
        "friction":0.37,
        "dynamicFriction":0.00035,
        "torqueLossCoef": 0.0155,
        "gearboxNode:":["tra1"],

        "gearWhineCoefsInput":  [0.60, 0.00, 0.12, 0.12, 0.12, 0.12, 0.12, 0.12, 0.12, 0.12],
        "gearWhineCoefsOutput": [0.00, 0.00, 0.24, 0.24, 0.24, 0.24, 0.24, 0.24, 0.24, 0.24],
        "gearWhineInputEvent": "event:>Vehicle>Transmission>helical_01>twine_in",
        "gearWhineOutputEvent": "event:>Vehicle>Transmission>helical_01>twine_out",

        "forwardInputPitchCoef":1.05
        "forwardOutputPitchCoef":1.05
        //"reverseInputPitchCoef":0.7
        //"reverseOutputPitchCoef":0.7

        //"gearWhineInputPitchCoefSmoothing":50
        //"gearWhineOutputPitchCoefSmoothing":50
        //"gearWhineInputVolumeCoefSmoothing":10
        //"gearWhineOutputVolumeCoefSmoothing":10

        //"gearWhineFixedCoefOutput": 0.7
        //"gearWhineFixedCoefInput": 0.4
    },
    "vehicleController": {
        //"lowShiftDownRPM":[0,0,0,1600,2100,2300,2300],
        //"lowShiftUpRPM":3500,
        "calculateOptimalLoadShiftPoints": true,
        "shiftDownRPMOffsetCoef":1.49,
        "transmissionShiftDelay":0.18,
        "lowShiftDownRPM":[0,0,0,1500,1700],
        "lowShiftUpRPM":[0,0,4000,3600,3600],
    },
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["pigeon_transmission", ["pigeon_engine","pigeon_transmission"]],
    ],
    "nodes": [
         ["id",   "posX", "posY", "posZ"],
         //--3 Speed Manual--
         {"selfCollision":false},
         {"collision":true},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"group":"pigeon_transmission"},
         {"nodeWeight":9},
         ["tra1", 0.0,   -0.1,    0.31],
         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":8001000,"beamDamp":150},
          {"beamDeform":100000,"beamStrength":"FLT_MAX"},
          //transmission
          ["tra1", "e1r"],
          ["tra1", "e3r"],
          ["tra1", "e1l"],
          ["tra1", "e3l"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
    "triangles": [
            ["id1:", "id2:", "id3:"],
            {"triangleType":"NONCOLLIDABLE"},
            ["e1l",  "e1r",  "tra1"],
            {"triangleType":"NORMALTYPE"},
    ],
},
