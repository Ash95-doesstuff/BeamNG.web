{
"pigeon_bin": {
    "information":{
        "authors":"BeamNG",
        "name":"Bin",
        "value":70,
    },
    "slotType" : "pigeon_bin",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["pigeon_binarm", ["pigeon_tailgate"]],
         ["pigeon_bin", ["pigeon_bin","pigeon_binhinge"]],
         ["pigeon_bintop", ["pigeon_binlid","pigeon_binhinge"]],
    ],
    "tailgateCoupler":{
        "$+closeForceMagnitude": 200,
    }
    "nodes": [
         ["id",    "posX", "posY", "posZ"],
         {"frictionCoef":0.8},
         {"nodeMaterial":"|NM_PLASTIC"},
         {"nodeWeight":1.0},
         {"collision":true},
         {"selfCollision":false},

         //mount
         {"group":"pigeon_tailgate"},
         ["bnm1r",-0.2,    1.8,    0.79],
         ["bnm1l", 0.2,    1.8,    0.79],
         {"selfCollision":true},

         //bin
         {"group":"pigeon_bin"},
         ["bin1l", 0.2,    1.85,   0.14],
         ["bin1r",-0.2,    1.85,   0.14],
         ["bin2l", 0.2,    2.23,   0.15],
         ["bin2r",-0.2,    2.23,   0.15],
         ["bin4l", 0.23,   1.8,    1.14],
         ["bin4r",-0.23,   1.8,    1.14],

         //hinge
         {"group":"pigeon_binhinge"},
         ["bin3l", 0.23,   2.21,   1.174],
         ["bin3r",-0.23,   2.21,   1.174],

         //lid
         {"group":"pigeon_binlid"},
         ["bld1l", 0.25,   1.78,   1.16],
         ["bld1r",-0.25,   1.78,   1.16],
         ["bld2",  -0.0,   1.94,   1.25],
         ["bld3",  -0.0,   1.94,   1.05],
         {"group":""},
    ],
    "beams": [
          ["id1:",  "id2:"],
          {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},

          //bin mount bracket
          {"beamSpring":601000,"beamDamp":40},
          {"beamDeform":20000,"beamStrength":100000},
          {"deformLimitExpansion":""},
          ["t1l",   "bnm1l"],
          ["t1",    "bnm1l"],
          ["t1r",   "bnm1l"],
          ["t2l",   "bnm1l"],
          ["t2",    "bnm1l"],
          ["t2r",   "bnm1l"],
          ["t1l",   "bnm1r"],
          ["t1",    "bnm1r"],
          ["t1r",   "bnm1r"],
          ["t2l",   "bnm1r"],
          ["t2",    "bnm1r"],
          ["t2r",   "bnm1r"],
          ["bnm1r", "bnm1l"],
          ["t4",    "bnm1r"],
          ["t4",    "bnm1l"],
          ["bnm1l", "t1ll"],
          ["bnm1l", "t2ll"],
          ["bnm1r", "t1rr"],
          ["bnm1r", "t2rr"],

          //bin
          {"deformLimitExpansion":1.1},
          {"beamSpring":461000,"beamDamp":140},
          {"beamDeform":40000,"beamStrength":100000},
          ["bin1l", "bin1r"],
          ["bin1l", "bin2r"],
          ["bin1r", "bin2l"],
          ["bin1l", "bin2l"],
          ["bin1r", "bin2r"],

          ["bin1l", "bin3r"],
          ["bin1r", "bin3l"],
          ["bin1l", "bin3l"],
          ["bin1r", "bin3r"],

          ["bin1l", "bin4r"],
          ["bin1r", "bin4l"],
          ["bin1l", "bin4l"],
          ["bin1r", "bin4r"],

          ["bin2l", "bin3r"],
          ["bin2r", "bin3l"],
          ["bin2l", "bin3l"],
          ["bin2r", "bin3r"],

          ["bin2l", "bin4r"],
          ["bin2r", "bin4l"],
          ["bin2l", "bin4l"],
          ["bin2r", "bin4r"],

          ["bin3l", "bin4r"],
          ["bin3r", "bin4l"],
          ["bin3l", "bin4l"],
          ["bin3r", "bin4r"],

          ["bin4l", "bin4r"],
          ["bin3l", "bin3r"],
          ["bin2l", "bin2r"],

          //bin lid
          ["bin3l", "bld1l"],
          ["bin3r", "bld1r"],
          ["bin3l", "bld1r"],
          ["bin3r", "bld1l"],
          ["bld1r", "bld1l"],

          //bin lid reinf
          ["bin3l", "bld2"],
          ["bin3r", "bld2"],
          ["bld1l", "bld2"],
          ["bld1r", "bld2"],
          ["bin3l", "bld3"],
          ["bin3r", "bld3"],
          ["bld2",  "bld3"],
          ["bld1l", "bld3"],
          ["bld1r", "bld3"],

          //bin attach
          {"deformLimitExpansion":""},
          {"beamSpring":701000,"beamDamp":40},
          {"beamDeform":30000,"beamStrength":5000},
          {"breakGroup":"bin_mount"},
          ["bnm1r", "bin4l"],
          ["bnm1l", "bin4r"],
          ["bnm1r", "bin4r"],
          ["bnm1l", "bin4l"],

          ["bnm1r", "bin1l"],
          ["bnm1l", "bin1r"],
          ["bnm1r", "bin1r"],
          ["bnm1l", "bin1l"],

          ["bnm1r", "bin3l"],
          ["bnm1l", "bin3r"],
          ["bnm1r", "bin3r"],
          ["bnm1l", "bin3l"],

          ["bnm1r", "bin2l"],
          ["bnm1l", "bin2r"],
          ["bnm1r", "bin2r"],
          ["bnm1l", "bin2l"],
          {"breakGroup":""},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"deformLimitExpansion":1.1},
    ],
    "triangles": [
            ["id1:",  "id2:",  "id3:"],
            {"group":"pigeon_bld"},
            {"dragCoef":6},
            {"groundModel":"plastic"},
            ["bld1l", "bld1r", "bin3r"],
            ["bld1l", "bin3r", "bin3l"],

            {"group":"pigeon_bin"},
            ["bin1l", "bin2l", "bin3l"],
            ["bin4l", "bin1l", "bin3l"],

            ["bin1r", "bin1l", "bin4l"],
            ["bin4r", "bin1r", "bin4l"],

            ["bin2r", "bin1r", "bin3r"],
            ["bin1r", "bin4r", "bin3r"],

            ["bin3l", "bin2l", "bin2r"],
            ["bin3l", "bin2r", "bin3r"],

            ["bin2l", "bin1l", "bin1r"],
            ["bin2l", "bin1r", "bin2r"],
            ["bin4l", "bnm1l", "bin1l"],
            ["bin4r", "bin1r", "bnm1r"],
            {"group":""},
    ],
},
}