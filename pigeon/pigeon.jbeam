{
"pigeon": {
    "information":{
        "authors":"BeamNG",
        "name": {
            "txt":"ui.vehicleconfig.information.name.BRAND BRAND",
            "ctx":{
                "brand1":"ui.vehicleconfig.brand.Ibishu",
                "brand2":"ui.vehicleconfig.brand.Pigeon"
            }
        },
    },
    "slotType" : "main",
    "slots2": [
        ["name",                    "allowTypes",                "denyTypes", "default",      "description"],
        //bodywork
        ["pigeon_frame",            ["pigeon_frame"],            [],          "pigeon_frame", "Frame",                   {"coreSlot":true}],
        ["paint_design",            ["paint_design"],            [],          "",             "Paint Design"],
        ["licenseplate_design_2_1", ["licenseplate_design_2_1"], [],          "",             "License Plate Design"],
        ["pigeon_mod",              ["pigeon_mod"],              [],          "",             "Additional Modification"],
    ],

    "scaledragCoef":1,

    "controller": [
        ["fileName"],
        ["vehicleController", {}],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$brakestrength", "range", "", "Brakes", 1, 0.6, 1.0, "Brake Force Multiplier", "Scales the overall brake torque for this setup", {"minDis":60, "maxDis":100}],
        ["$ffbstrength", "range", "", "Chassis", 1, 0.5, 1.5, "Setup-Specific Force Feedback Multiplier", "Scales the force feedback strength for THIS SETUP ONLY", {"minDis":50, "maxDis":150}],
        ["$headlightPitchComp", "range", "degree", "Headlights", 0, -3, 3, "Setup Specific Headlight Pitch Compensation", "Adjusts the headlight pitch  for this setup", {"minDis":-3, "maxDis":3}]
    ],
    "components": {
        "electrics": {
            "customValues": [
                ["electricsName", "electricsFunction","electricsDefault"],
                ["signal_L_filament","electrics.signal_L * electrics.electricalLoadCoef",0],
                ["signal_R_filament","electrics.signal_R * electrics.electricalLoadCoef",0],
                ["lowhighBrake_filament","(electrics.lowhighbeam * 0.25  + electrics.brakelights * 0.75 ) * electrics.electricalLoadCoef",0],
                ["lowbeam_filament","electrics.lowbeam * electrics.electricalLoadCoef",0],
                ["lowhighbeam_filament","electrics.lowhighbeam * electrics.electricalLoadCoef",0],
                ["lowhighbeam_filament_alt","(electrics.lowhighbeam + electrics.highbeam) * 0.5 * electrics.electricalLoadCoef",0],
								["highbeam_filament","electrics.highbeam * electrics.electricalLoadCoef",0],
                ["reverselight_filament","electrics.reverse * electrics.electricalLoadCoef",0],
                ["foglight_filament","electrics.fog * electrics.electricalLoadCoef",0],
                ["generic_taillight","electrics.lowhighbeam * 0.3 * electrics.electricalLoadCoef",0],
                ["generic_brakelight","electrics.brakelights * electrics.electricalLoadCoef",0],
                ["generic_reverse","electrics.reverse * electrics.electricalLoadCoef",0],
                ["generic_fog","electrics.fog * electrics.electricalLoadCoef",0],
                ["generic_signal_L","electrics.signal_L * electrics.electricalLoadCoef",0],
                ["generic_signal_R","electrics.signal_R * electrics.electricalLoadCoef",0],
            ],
            "smoothers": [
                ["electricsName", "smootherType", "params"],
                ["signal_L_filament","temporalNonLinear", [17,17]],
                ["signal_R_filament","temporalNonLinear", [17,17]],
                ["lowhighBrake_filament","temporalNonLinear", [10,10]],
                ["lowbeam_filament","temporalNonLinear", [10,10]],
                ["lowhighbeam_filament","temporalNonLinear", [10,10]],
                ["lowhighbeam_filament_alt","temporalNonLinear", [10,10]],
                ["highbeam_filament","temporalNonLinear", [10,10]],
                ["reverselight_filament","temporalNonLinear", [10,10]],
                ["foglight_filament","temporalNonLinear", [10,10]],
                ["generic_taillight","temporalNonLinear", [15,15]],
                ["generic_brakelight","temporalNonLinear", [15,15]],
                ["generic_reverse","temporalNonLinear", [15,15]],
                ["generic_fog","temporalNonLinear", [15,15]],
                ["generic_signal_L","temporalNonLinear", [15,15]],
                ["generic_signal_R","temporalNonLinear", [15,15]],
            ],
        },
    },
    "glowMap":{
            "pigeon_signal_L":    {"simpleFunction":"signal_L_filament",       "off":"pigeon_lights", "on":"pigeon_lights_on_intense", "materialEmissiveScaling":{"on_max":0.49}},
            "pigeon_signal_R":    {"simpleFunction":"signal_R_filament",       "off":"pigeon_lights", "on":"pigeon_lights_on_intense", "materialEmissiveScaling":{"on_max":0.49}},
            "pigeon_taillight_L": {"simpleFunction":"lowhighBrake_filament",   "off":"pigeon_lights", "on":"pigeon_lights_on_intense", "materialEmissiveScaling":{"on_max":1.00}},
            "pigeon_taillight_R": {"simpleFunction":"lowhighBrake_filament",   "off":"pigeon_lights", "on":"pigeon_lights_on_intense", "materialEmissiveScaling":{"on_max":1.00}},
            "pigeon_headlights":  {"simpleFunction":"lowhighbeam_filament_alt","off":"pigeon_lights", "on":"pigeon_lights_on_intense", "materialEmissiveScaling":{"on_max":1.00}},
            "pigeon_reverselight":{"simpleFunction":"reverselight_filament",   "off":"pigeon_lights", "on":"pigeon_lights_on_intense", "materialEmissiveScaling":{"on_max":0.49}},
            "pigeon_foglights":   {"simpleFunction":"foglight_filament",       "off":"pigeon_lights", "on":"pigeon_lights_on_intense", "materialEmissiveScaling":{"on_max":1.00}},
            "pigeon_dials":       {"simpleFunction":"lowhighbeam_filament",    "off":"pigeon_dials",  "on":"pigeon_dials_on",          "materialEmissiveScaling":{"on_max":1.00}},
            "generic_halogen_taillight":           {"simpleFunction":"generic_taillight", "off":"generic_halogen",            "on":"generic_halogen_on_intense",            "materialEmissiveScaling":{"on_max":0.49}},
            "generic_halogen_glass_taillight":     {"simpleFunction":"generic_taillight", "off":"generic_halogen_glass",      "on":"generic_halogen_glass_on_intense",      "materialEmissiveScaling":{"on_max":0.49}},
            "generic_halogen_brakelight":          {"simpleFunction":"generic_brakelight","off":"generic_halogen",            "on":"generic_halogen_on_intense",            "materialEmissiveScaling":{"on_max":0.49}},
            "generic_halogen_glass_brakelight":    {"simpleFunction":"generic_brakelight","off":"generic_halogen_glass",      "on":"generic_halogen_glass_on_intense",      "materialEmissiveScaling":{"on_max":0.49}},
            "generic_halogen_reverse":             {"simpleFunction":"generic_reverse",   "off":"generic_halogen",            "on":"generic_halogen_on_intense",            "materialEmissiveScaling":{"on_max":0.49}},
            "generic_halogen_glass_reverse":       {"simpleFunction":"generic_reverse",   "off":"generic_halogen_glass",      "on":"generic_halogen_glass_on_intense",      "materialEmissiveScaling":{"on_max":0.49}},
            "generic_halogen_fog":                 {"simpleFunction":"generic_fog",       "off":"generic_halogen",            "on":"generic_halogen_on_intense",            "materialEmissiveScaling":{"on_max":1.00}},
            "generic_halogen_glass_fog":           {"simpleFunction":"generic_fog",       "off":"generic_halogen_glass",      "on":"generic_halogen_glass_on_intense",      "materialEmissiveScaling":{"on_max":1.00}},
            "generic_halogen_signal_L_amber":      {"simpleFunction":"generic_signal_L",  "off":"generic_halogen",            "on":"generic_halogen_on_intense",            "materialEmissiveScaling":{"on_max":0.49}},
            "generic_halogen_glass_signal_L_amber":{"simpleFunction":"generic_signal_L",  "off":"generic_halogen_glass_amber","on":"generic_halogen_glass_on_intense_amber","materialEmissiveScaling":{"on_max":0.49}},
            "generic_halogen_signal_R_amber":      {"simpleFunction":"generic_signal_R",  "off":"generic_halogen",            "on":"generic_halogen_on_intense",            "materialEmissiveScaling":{"on_max":0.49}},
            "generic_halogen_glass_signal_R_amber":{"simpleFunction":"generic_signal_R",  "off":"generic_halogen_glass_amber","on":"generic_halogen_glass_on_intense_amber","materialEmissiveScaling":{"on_max":0.49}},

            //gauge lights
            "signal_L":{"simpleFunction":"signal_L", "off":"invis", "on":"decals_gauges"},
            "signal_R":{"simpleFunction":"signal_R", "off":"invis", "on":"decals_gauges"},
            "highbeam":{"simpleFunction":"highbeam", "off":"invis", "on":"decals_gauges"},
    },
},
"pigeon_skin_streetcleaning": {
    "information":{
        "authors":"BeamNG",
        "name":"Street Cleaning Livery",
        "value":1900,
    },
    "slotType" : "paint_design",
    "globalSkin" : "streetcleaning",
},
"pigeon_skin_birdabduction": {
    "information":{
        "authors":"BeamNG",
        "name":"Bird Response Livery",
        "value":1500,
    },
    "slotType" : "paint_design",
    "globalSkin" : "birdabduction",
},
"pigeon_skin_twotone": {
    "information":{
        "authors":"BeamNG",
        "name":"Two-Tone",
        "value":1500,
    },
    "slotType" : "paint_design",
    "globalSkin" : "twotone",
},
"pigeon_skin_old": {
    "information":{
        "authors":"BeamNG",
        "name":"Old Paint (Colorable)",
        "value":0
    },
    "slotType" : "paint_design",
    "globalSkin" : "old"
},
"pigeon_skin_gambler": {
    "information":{
        "authors":"BeamNG",
        "name": {
            "txt":"ui.vehicleconfig.information.name.BRAND (Colorable)",
            "ctx":{
                "brand1":"ui.vehicleconfig.brand.Gambler 500"
            }
        },
        "value":100
    },
    "slotType" : "paint_design",
    "globalSkin" : "gambler"
}
}
