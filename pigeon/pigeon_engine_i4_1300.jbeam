        "torqueModIntake":[
            ["rpm", "torque"],
            [0, 0],
            [1000, 0],
            [2000, 0.8],
            [3000, 1.3],
            [4000, 1.7],
            [5000, 3.6],
            [6000, 6],
            [7000, 7.2],
            [8000, 8.5],
            [9000, 9.4],
